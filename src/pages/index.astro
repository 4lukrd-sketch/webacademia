  };
  btns.forEach(b => b.addEventListener('click', () => show(b)));
  const cur = btns[btns.length - 1];
  if (cur) {
    moveThumb(cur);
    addEventListener('resize', () => moveThumb(btns.find(b => b.getAttribute('aria-selected') === 'true')!));
    new IntersectionObserver((es, o) => es.forEach(e => e.isIntersecting && (show(cur), o.disconnect())), { threshold: .4 }).observe(tabs);
  }

