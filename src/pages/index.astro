  backdrop?.addEventListener('click', () => openDrawer(false));
  $$('.drawer-nav a').forEach(a => a.addEventListener('click', () => openDrawer(false)));

  // 3. Scroll y Spy
  const gnav = $('#gnav'), snav = $('#snav'), hero = $('.hero');
  const onScroll = () => {
    gnav.classList.toggle('edge', scrollY > 4);
    snav.classList.toggle('on', hero.getBoundingClientRect().bottom < 120);
  };
  addEventListener('scroll', onScroll, { passive: true }); onScroll();
  const links = $$('[data-spy]');
  const spy = new IntersectionObserver(es => es.forEach(e => {
    if (e.isIntersecting) links.forEach(l => l.classList.toggle('cur', l.dataset.spy === e.target.id));
  }), { rootMargin: '-45% 0px -50% 0px' });
  links.forEach(l => { const s = document.getElementById(l.dataset.spy!); s && spy.observe(s); });

  // 4. Estadísticas y animaciones
  const tabs = $('.tabs'), btns = $$('[data-t]', tabs), thumb = $('.thumb', tabs), panels = $$('.tp', tabs);
  const moveThumb = (b: HTMLElement) => { thumb.style.width = b.offsetWidth + 'px'; thumb.style.transform = `translateX(${b.offsetLeft}px)`; };
  const show = (b: HTMLElement) => {
    btns.forEach(x => x.setAttribute('aria-selected', String(x === b)));
    moveThumb(b);
    panels.forEach(p => { p.hidden = p.dataset.p !== b.dataset.t; p.classList.remove('go'); });
