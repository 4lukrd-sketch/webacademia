---
import { latestPosts, convocatorias } from '../lib/wp';
import { razones, requisitos, stats, comunes, comunes2, tarifas, requisitosOposicion, pruebas, municipios, resenasGoogle } from '../data/content';
const [posts, convs] = await Promise.all([latestPosts(), convocatorias()]);
const W = 'https://www.isfes.es';
const titulo = 'Tu Academia de Oposiciones a Policía Local de Zaragoza y Aragón';
const desc = 'Cumple tu sueño de ser Policía Local. En Academia ISFES te explicamos como conseguirlo y te ayudamos en todo el proceso.';
const plazas = 'https://www.zaragoza.es/oferta/ofertaDetalle.jsp?id=1703';
const YT_CLASES = 'PTco3JqwEyw';
const YT_SHORT = '49oeoVfNyUA';
const HERO = `${W}/wp-content/uploads/2021/02/banner-academia-2021.jpg`;
const num = (t: string) => { const m = t.match(/(\d+)%/); return m ? +m[1] / 100 : null; };
const nav = [['formacion','Formación'],['requisitos','Requisitos'],['resultados','Resultados'],['tarifas','Tarifas'],['convocatorias','Convocatorias'],['contacto','Contacto']];
const mainLinks = [['Inicio','/'],['Quiénes somos','/sobre-nosotros/'],['Cursos online','/cursos-online/'],['Tienda','/tienda-isfes/'],['Eventos','/eventos-isfes/'],['Contacto','/contacto/']];
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titulo}</title>
  <meta name="description" content={desc} />
  <link rel="canonical" href="https://www.isfes.es/academia-policia-local/" />
  <meta property="og:title" content={titulo} /><meta property="og:description" content={desc} /><meta property="og:image" content={HERO} />
  <meta name="theme-color" content="#fbfbfd" />
  <meta name="referrer" content="no-referrer" />
  <link rel="icon" href={`${W}/wp-content/uploads/2024/02/cropped-favicon-isfes-300x300.jpg`} />

  <!-- Preconnect y preload de fuentes críticas -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&display=swap" />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Preload de imagen crítica del Hero (LCP) -->
  <link rel="preload" as="image" href={HERO} fetchpriority="high" />
</head>
<body>
<a class="skip" href="#main">Saltar al contenido</a>

<!-- Menú Global con soporte Responsive Accesible -->
<header class="gnav" id="gnav">
  <div class="gnav-in">
    <a href={W} class="brand" aria-label="ISFES, inicio">
      <img src={`${W}/wp-content/uploads/2022/10/logo-isfes-es-22-sf.png`} alt="ISFES" width="108" height="30" />
    </a>
    
    <nav class="gnav-desk" aria-label="Principal escritorio">
      {mainLinks.map(([t,p]) => <a href={W+p}>{t}</a>)}
      <a href="https://aula.isfes.es/" class="gnav-aula">Aula virtual</a>
    </nav>

    <div class="gnav-actions">
      <a href="https://aula.isfes.es/" class="btn sm gnav-mob-aula">Aula virtual</a>
      <button class="nav-toggle" id="nav-toggle" aria-label="Abrir menú de navegación" aria-expanded="false" aria-controls="mobile-drawer">
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>
  </div>
</header>

<!-- Drawer móvil -->
<div class="drawer" id="mobile-drawer" aria-hidden="true">
  <div class="drawer-backdrop" id="drawer-backdrop"></div>
  <div class="drawer-content">
    <div class="drawer-top">
      <span class="drawer-t">Menú ISFES</span>
      <button class="drawer-close" id="drawer-close" aria-label="Cerrar menú">✕</button>
    </div>
    <nav class="drawer-nav">
      {mainLinks.map(([t,p]) => <a href={W+p}>{t}</a>)}
      <a href="https://aula.isfes.es/" class="drawer-highlight">Aula virtual ISFES</a>
    </nav>
    <div class="drawer-footer">
      <a class="btn" style="width:100%;justify-content:center;" href={`${W}/academia-policia-local/inscripcion/`}>Inscripción 2026</a>
    </div>
  </div>
</div>

<!-- Subnav flotante -->
<div class="snav" id="snav" aria-label="En esta página"><div class="snav-in">
  <span class="snav-t">Academia Policía Local</span>
  <div class="snav-l">{nav.map(([id,t]) => <a href={`#${id}`} data-spy={id}>{t}</a>)}</div>
  <a class="btn sm" href={`${W}/academia-policia-local/inscripcion/`}>Inscríbete</a>
</div></div>

<main id="main">
<section class="hero">
  <a class="live rise" style="--d:0s" href={plazas}><i aria-hidden="true"></i>Más de 40 plazas convocadas en 2026 para Zaragoza<b aria-hidden="true">›</b></a>
  <h1 class="rise" style="--d:.08s">Academia de Oposiciones a Policía Local de Zaragoza y Aragón. <span>Temario actualizado, tests y clases online.</span></h1>
  <p class="rise cta-row" style="--d:.18s"><a class="btn" href="#contacto">Contáctanos</a><a class="tl" href="#tarifas">Ver tarifas</a></p>
  <figure class="photo rise" style="--d:.28s">
    <img src={HERO} alt="Alumnos y preparación en Academia ISFES" fetchpriority="high" width="1080" height="462" />
    <img class="plogo" src={`${W}/wp-content/uploads/2021/03/Nuevo-logo-academia5-BLANCO-768x380.png`} alt="ISFES Academia de Policía Local en Zaragoza y Aragón" width="200" height="99" />
    <figcaption>“En ISFES te ayudamos hasta conseguir tu sueño de ser Policía Local”</figcaption>
  </figure>
</section>

<section class="sec" aria-labelledby="t-quieres">
  <div class="wrap">
    <p class="statement" id="t-quieres">¿Quieres ser Policía Local? <span>En academia ISFES te preparamos para superar con garantías todas las pruebas de la oposición.</span></p>
    <div class="cols2 body-l">
      <p>Prepárate con garantías de éxito y en un buen ambiente de opositores en una de las mejores academias de Policía Local de Aragón. Somos un equipo de Policías Locales, Mandos de Policía, Policía Nacional y personal experto en psicología y RR.HH que llevamos varios años preparando con garantías a opositores en Aragón.</p>
      <p>En la <b>Academia de Policía Local ISFES</b> puedes formarte de manera <b>online</b> y <b>presencial</b> TODAS las pruebas de la oposición con el único objetivo de conseguir tu plaza en la próxima convocatoria.</p>
    </div>
    <p class="flags">
      <img src="https://upload.wikimedia.org/wikipedia/commons/c/cc/Bandera_de_Zaragoza.svg" alt="Bandera de Zaragoza" width="180" height="120" loading="lazy" decoding="async" />
      <img src="https://upload.wikimedia.org/wikipedia/commons/e/e8/Bandera_de_Arag%C3%B3n.svg" alt="Bandera de Aragón" width="180" height="120" loading="lazy" decoding="async" />
    </p>
  </div>
</section>

<section class="sec tint" id="formacion">
  <div class="wrap">
    <h2>¿Por qué elegir ISFES? <span>¿Cómo es nuestra formación?</span></h2>
    <ul class="why">{razones.map(r => <li><img src={r.img} alt="" width="34" height="34" loading="lazy" decoding="async" /><span>{r.text}</span></li>)}</ul>
  </div>
</section>

<section class="sec">
  <div class="wrap bento">
    <!-- Tile con Lazy YouTube Facade (Ahorra ~1.2MB de JS no solicitado) -->
    <div class="tile zoom">
      <h3>Todas las clases, en directo y grabadas.</h3>
      <p>Nuestro curso con <b>todas las clases en directo</b> a través de ZOOM y grabadas para visualizarlas en nuestra aula online.</p>
      <div class="yt-facade" data-id={YT_CLASES} data-title="Clases online de academia ISFES" style="margin-top:auto;width:100%;aspect-ratio:16/9;">
        <img src={`https://img.youtube.com/vi/${YT_CLASES}/hqdefault.jpg`} alt="Vista previa clases ISFES" loading="lazy" decoding="async" />
        <button type="button" class="yt-btn" aria-label="Reproducir vídeo de presentación de clases">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
        </button>
      </div>
    </div>

    <!-- Tile Bot Telegram con Facade para Short -->
    <div class="tile test">
      <img class="tgi" src="https://cdn-icons-png.flaticon.com/512/408/408737.png" alt="Telegram" width="76" height="76" loading="lazy" decoding="async" />
      <h3>Un bot de Telegram con miles de preguntas.</h3>
      <div class="tg-in">
        <div>
          <p>Prueba nuestro <b>bot de Telegram con miles de preguntas</b> de alta dificultad del temario. Además más de 700 preguntas de convocatorias anteriores y ascensos.</p>
          <p class="cta-row"><a class="btn" href="https://t.me/testoposicion_bot" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.9 3.6 2.7 11c-1.3.5-1.3 1.3-.2 1.6l4.9 1.5 1.9 5.8c.2.6.4.8.9.8.4 0 .6-.2.9-.5l2.4-2.3 4.9 3.6c.9.5 1.5.2 1.8-.8l3.2-15.2c.3-1.3-.5-1.9-1.5-1.5Zm-3.4 3.5-8.6 7.8-.3 3.4-1.7-5.2 10.6-6.4c.5-.3.9-.1.5.2Z"/></svg>Test gratuitos</a></p>
        </div>
        <div class="yt-facade short" data-id={YT_SHORT} data-title="Bot de preguntas ISFES">
          <img src={`https://img.youtube.com/vi/${YT_SHORT}/hqdefault.jpg`} alt="Vista previa bot de preguntas" loading="lazy" decoding="async" />
          <button type="button" class="yt-btn" aria-label="Reproducir Short de demostración">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          </button>
        </div>
      </div>
    </div>

    <div class="tile qtile">
      <div>
        <h3>Practica el test antes del examen.</h3>
        <p>Así es una pregunta del examen: 3 respuestas alternativas y solo una correcta. Pruébalo ahora mismo.</p>
      </div>
      <div class="quiz" id="quiz">
        <p class="q-meta">Pregunta de ejemplo · Constitución Española</p>
        <p class="q" id="q-text">¿Cuál es el plazo máximo de la detención preventiva?</p>
        <div class="opts" role="group" aria-labelledby="q-text">
          <button type="button" data-ok="0"><i>A</i>24 horas</button>
          <button type="button" data-ok="0"><i>B</i>48 horas</button>
          <button type="button" data-ok="1"><i>C</i>72 horas</button>
        </div>
        <div class="why-q" aria-live="polite"><div><p id="q-res"></p><button type="button" class="tl" id="q-again">Probar otra vez</button></div></div>
      </div>
    </div>
  </div>
</section>

<!-- Sección Reseñas Certificadas de Google -->
<section class="sec tint" id="testimonios" aria-labelledby="t-opiniones">
  <div class="wrap">
    <div class="reviews-header">
      <div>
        <h2 id="t-opiniones">Testimonios de nuestr@s alumn@s certificados en Google.</h2>
        <p class="body-l" style="margin-top:.5rem;">Opiniones reales de opositores que han preparado su plaza con ISFES.</p>
      </div>
      <a class="btn sm" href="https://www.google.com/maps/place/Academia+Oposiciones+Polic%C3%ADa+Local+ISFES/@41.6467466,-0.8962256,17z/data=!3m1!4b1!4m6!3m5!1s0xd5915ff5524752b:0x3c2778c5cd9c77c7!8m2!3d41.6467466!4d-0.8962256!16s%2Fg%2F11t47lvmfg" target="_blank" rel="noopener">Ver ficha en Google Maps</a>
    </div>

    <!-- Contenedor del widget de Elfsight con carga perezosa -->
    <div class="elfsight-container" id="elfsight-wrapper">
      <div class="elfsight-app-de903cba-43ea-4e1d-be78-16d37dcc48ca" data-elfsight-app-lazy></div>
      
      <!-- Skeleton mientras carga para evitar saltos de pantalla (CLS = 0) -->
      <div class="widget-skeleton" id="widget-skeleton">
        <div class="skeleton-pulse"></div>
        <p>Cargando opiniones verificadas de Google...</p>
      </div>
    </div>
  </div>
</section>

<section class="sec" id="requisitos">
  <div class="wrap narrow">
    <h2>Requisitos para ser Policía Local.</h2>
    <dl class="specs">{requisitos.map(([t,d]) => <div><dt>{t}</dt><dd>{d}</dd></div>)}</dl>
  </div>
</section>

<section class="sec tint tabs" id="resultados">
  <div class="wrap narrow">
    <h2>Estadísticas de aprobados.</h2>
    <div class="seg" role="tablist" aria-label="Año">{stats.map(([y], i) => <button role="tab" type="button" aria-selected={i === stats.length - 1} data-t={y}>{y}</button>)}<span class="thumb" aria-hidden="true"></span></div>
    {stats.map(([y, ps], i) => <div class="tp" role="tabpanel" data-p={y} hidden={i !== stats.length - 1}>{ps.map(t => (
      <div class="stat"><p set:html={t} />{num(t) !== null && <div class="meter" style={`--v:${num(t)}`} role="img" aria-label={`${Math.round(num(t)! * 100)} por ciento`}><span></span></div>}</div>))}</div>)}
  </div>
</section>

<section class="sec" id="tarifas">
  <div class="wrap">
    <h2>Tarifas y servicios actuales.</h2>
    <div class="plans">{tarifas.map((t, i) => (
      <article class={'plan' + (i === 0 ? ' rec' : '')}>
        <h3>{t.nombre}{i === 0 && <em>Recomendado</em>}</h3>
        <p class="price">{t.precio} €<small>/mes</small></p>
        <p class="pl">{t.clases}</p>
        <a class="tl" href="#contacto">Preguntar por este plan</a>
      </article>))}</div>
    <h3 class="incl-t">Incluido en todos los planes</h3>
    <ul class="incl">{[...comunes, ...comunes2].map(c => <li>{c}</li>)}</ul>
  </div>
</section>

<section class="sec tint" id="contacto">
  <div class="wrap">
    <h2>Contáctanos. <span>Infórmate sin compromiso y recibe acceso a uno de nuestros módulos online GRATIS.</span></h2>
    <div class="contact">
      <div>
        <ul class="ways">
          <li><a href="https://wa.me/message/BCLK4RF5372OK1" target="_blank" rel="noopener"><i class="dot g" aria-hidden="true"></i><span><b>WhatsApp</b>Escríbenos directamente por WhatsApp.</span></a></li>
          <li><a href="tel:+34644555510"><i class="dot" aria-hidden="true"></i><span><b>Teléfono</b>Rubén (coordinador) - 644 55 55 10</span></a></li>
          <li><a href="mailto:academia@isfes.es"><i class="dot" aria-hidden="true"></i><span><b>Correo electrónico</b>academia@isfes.es</span></a></li>
        </ul>
        <p class="note">Rellena nuestro formulario de inscripción online sin ningún tipo de compromiso.</p>
        <p class="cta-row"><a class="btn" href={`${W}/academia-policia-local/inscripcion/`}>Inscripción</a></p>
      </div>
      <div>
        <iframe class="map" title="Mapa de la academia" loading="lazy" src="https://maps.google.com/maps?q=Academia%20Polic%C3%ADa%20Local%20Zaragoza%20ISFES&t=m&z=15&output=embed&iwloc=near"></iframe>
        <h3 class="where">¿Dónde estamos?</h3>
        <p class="note">Nuestras aulas se encuentran situadas en el centro de estudios CID, sito en Av. Valencia 28, 50005, Zaragoza</p>
        <a href="https://www.centroestudioscid.es/" target="_blank" rel="noopener">
          <img src={`${W}/wp-content/uploads/2024/12/logo-cid-300x105.png`} alt="CID Centro de estudios" width="150" height="52" loading="lazy" decoding="async" />
        </a>
      </div>
    </div>
  </div>
</section>

<section class="sec" id="convocatorias">
  <div class="wrap narrow">
    <h2>Oposición a Policía Local; convocatorias, temario, requisitos. <span>Toda la información sobre las oposiciones en Zaragoza y Aragón.</span></h2>
    <p class="lede"><a class="tl" href={plazas}>Más de 40 plazas convocadas en 2026 para Zaragoza (Libres y movilidad)</a></p>
    <p class="cta-row"><a class="btn" href="https://www.zaragoza.es/oferta/verHTMLOferta.jsp?id=1703&tipo=bases" target="_blank" rel="noopener">Ver bases oposición 2026</a><a class="tl" href={`${W}/hacer-examen-test-policia-local-2026`}>Hacer el último examen de oposición (2026)</a></p>
    <div class="acc">
      <details><summary>Requisitos detallados</summary><div class="acc-b"><ul>{requisitosOposicion.map(([t,d]) => <li><b>{t}</b>: {d}</li>)}</ul>
        <p class="note">Todos los requisitos deberán poseerse el día que finalice el plazo de presentación de solicitudes y mantenerse en la toma de posesión, excepto el permiso de conducir, que deberá poseerse cuando se haga pública la relación de aspirantes que hayan superado el curso de formación.</p>
        <a class="tl" href={`${W}/requisitos-policia-local-zaragoza/`}>Requisitos detallados</a></div></details>
      <details><summary>Temario detallado</summary><div class="acc-b"><p>Listado de los 50 temas de la oposición.</p><a class="tl" href={`${W}/temas-oposicion-policia-local-zaragoza/`}>Ver temario completo</a></div></details>
      <details open><summary>¿Qué pruebas debo superar?</summary><div class="acc-b">{pruebas.map(([t,d]) => <p><b>{t}</b><br />{d}</p>)}<a class="tl" href={`${W}/exclusiones-medicas-policia-local-zaragoza/`}>Ver las exclusiones médicas de la oposición</a></div></details>
    </div>
  </div>
</section>

<section class="sec tint">
  <div class="wrap narrow">
    <h2>Convocatorias de plazas en otros municipios.</h2>
    <p class="body-l">Aquí tienes un listado de las diferentes convocatorias de plazas en Zaragoza y municipios cercanos. En <a class="tl" href={`${W}/blog/`}>nuestro blog</a> también puedes ver la evolución de las <a class="tl" href={`${W}/oposiciones-a-policia-local-desde-2006/`}>convocatorias de plazas para policía local en Zaragoza</a>.</p>
    <label class="find"><span>Buscar municipio</span><input id="find" type="search" placeholder="Huesca, Caspe, Jaca…" autocomplete="off" /></label>
    <div class="tbl"><table><thead><tr><th>Municipio</th><th>Instancias</th><th>Nº plazas</th><th>Bases</th></tr></thead>
      <tbody id="rows">{municipios.map(([m,i,n,u,info]) => <tr><td>{m}{info && <> <a class="tl" href={info}>+Info</a></>}</td><td>{i}</td><td>{n}</td><td><a class="tl" href={u}>Bases</a></td></tr>)}</tbody></table>
      <p class="empty" id="empty" hidden>Ningún municipio coincide. Prueba con otro nombre.</p></div>
  </div>
</section>

<section class="sec">
  <div class="wrap">
    <div class="head-row"><h2><a href={`${W}/oposiciones/policia-local/convocatorias-policia-local/`}>Últimas convocatorias para Policía Local en Aragón.</a></h2>
      <div class="arrows"><button type="button" id="prev" aria-label="Anterior" disabled>‹</button><button type="button" id="next" aria-label="Siguiente">›</button></div></div>
    <div class="rail" id="rail" tabindex="0" aria-label="Convocatorias">{convs.map(p => (
      <article class="post">{p.image && <a href={p.link} tabindex="-1" aria-hidden="true"><img src={p.image} alt="" loading="lazy" decoding="async" /></a>}
        <time>{p.date}</time><h3><a href={p.link}>{p.title}</a></h3><p>{p.excerpt}</p></article>))}</div>
  </div>
</section>

<section class="sec tint">
  <div class="wrap">
    <h2><a href={`${W}/blog/`}>Conoce los artículos de nuestro blog para opositores.</a></h2>
    <div class="news">{posts.map((p, i) => (
      <article class={'post' + (i === 0 ? ' feat' : '')}>{p.image && <a href={p.link} tabindex="-1" aria-hidden="true"><img src={p.image} alt="" loading="lazy" decoding="async" /></a>}
        <time>{p.date}</time><h3><a href={p.link}>{p.title}</a></h3><p>{p.excerpt}</p></article>))}</div>
  </div>
</section>
</main>

<footer><div class="wrap">
  <p><a href={`${W}/aviso-legal/`}>Aviso Legal</a><a href={`${W}/politica-de-privacidad-isfes/`}>Política de Privacidad</a><a href={`${W}/politica-de-cookies/`}>Política de Cookies</a><a href={`${W}/politica-de-ventas/`}>Política de Ventas</a></p>
  <p><a href="mailto:info@isfes.es">info@isfes.es</a><a href="https://facebook.com/isfeses/">Facebook</a><a href="https://www.instagram.com/isfes.es/">Instagram</a><a href="https://twitter.com/isfeses">X</a></p>
  <p class="legal">Instituto Social y Formativo de las Emergencias y de la Seguridad 2026 ©</p>
</div></footer>

<script>
  const $ = <T extends HTMLElement>(s: string, r: ParentNode = document) => r.querySelector(s) as T;
  const $$ = <T extends HTMLElement>(s: string, r: ParentNode = document) => [...r.querySelectorAll(s)] as T[];

  // 1. YouTube Facade: Solo inserta el iframe al hacer click (Ahorra bloqueo de JS y ~1.5s TBT)
  $$('.yt-facade').forEach(el => {
    const btn = el.querySelector('button');
    const startVideo = () => {
      const id = el.dataset.id;
      const title = el.dataset.title || 'Vídeo';
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;
      iframe.title = title;
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.className = el.classList.contains('short') ? 'short' : '';
      iframe.style.width = '100%';
      iframe.style.height = '100%';
      iframe.style.borderRadius = 'inherit';
      iframe.style.border = '0';
      el.replaceWith(iframe);
    };
    btn?.addEventListener('click', startVideo, { once: true });
    el.addEventListener('click', (e) => { if (e.target !== btn) startVideo(); }, { once: true });
  });

  // 2. Menú Drawer Móvil
  const toggle = $('#nav-toggle'), drawer = $('#mobile-drawer'), backdrop = $('#drawer-backdrop'), closeBtn = $('#drawer-close');
  const openDrawer = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    drawer?.classList.toggle('open', open);
    drawer?.setAttribute('aria-hidden', String(!open));
