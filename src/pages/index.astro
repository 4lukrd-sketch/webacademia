  opts.forEach(o => o.addEventListener('click', () => {
    const ok = o.dataset.ok === '1';
    quiz.classList.add('done'); opts.forEach(x => { x.disabled = true; if (x.dataset.ok === '1') x.classList.add('ok'); });
    if (!ok) o.classList.add('ko');
    res.textContent = ok ? 'Correcto. Artículo 17.2 de la Constitución: setenta y dos horas como máximo.' : 'No es esa. Según el artículo 17.2 de la Constitución, el máximo son setenta y dos horas.';
  }));
  $('#q-again')?.addEventListener('click', () => { quiz.classList.remove('done'); opts.forEach(x => { x.disabled = false; x.className = ''; }); res.textContent = ''; });

  // 6. Filtro tabla municipios
  const rows = $$('#rows tr'), empty = $('#empty');
  $<HTMLInputElement>('#find')?.addEventListener('input', e => {
    const q = (e.target as HTMLInputElement).value.trim().toLowerCase(); let n = 0;
    rows.forEach(r => { const hit = r.cells[0].textContent!.toLowerCase().includes(q); r.hidden = !hit; if (hit) n++; });
    if (empty) empty.hidden = n > 0;
