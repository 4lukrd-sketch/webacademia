const wrapper = document.getElementById('elfsight-wrapper');
const skeleton = document.getElementById('widget-skeleton');

if (wrapper) {
  const observer = new IntersectionObserver((entries, obs) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
